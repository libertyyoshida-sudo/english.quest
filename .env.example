# Neon (https://console.neon.tech) の Project > Connect から取得
# Pooled connection: アプリの通常クエリ用（PgBouncer 経由、-pooler が付く）
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require"

# Direct (unpooled) connection: prisma migrate 専用
DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require"

JWT_SECRET="change-me-to-a-long-random-string"
PORT=3001

# Google Cloud Console の OAuth 2.0 クライアントID（Web application）
# 承認済みJavaScript生成元に GitHub Pages URL とローカル開発URLを登録する
GOOGLE_CLIENT_ID="<your-google-client-id>.apps.googleusercontent.com"
